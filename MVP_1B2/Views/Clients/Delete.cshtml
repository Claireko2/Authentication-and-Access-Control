@model MVP_1B2.Models.Client

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Client</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Balance)
        </dt>
        <dd class="col-sm-10">
            @if (Model.Balance != null)
            {
                @Html.DisplayFor(model => model.Balance)
            }
            else
            {
                <span>No balance available</span>
            }
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DateOfBirth)
        </dt>
        <dd class="col-sm-10">
            @if (Model.DateOfBirth != null)
            {
                @Html.DisplayFor(model => model.DateOfBirth)
            }
            else
            {
                <span>No date of birth available</span>
            }
        </dd>

        <dt class="col-sm-2">
            Photo
        </dt>
        <dd class="col-sm-10">
            @if (Model.Photo != null && Model.Photo.Length > 0)
            {
                <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Photo)" alt="Client Photo" style="width: 200px; height: auto;" />
            }
            else
            {
                <span>No photo available</span>
            }
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.Name))
            {
                @Html.DisplayFor(model => model.Name)
            }
            else
            {
                <span>No name available</span>
            }
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Address)
        </dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.Address))
            {
                @Html.DisplayFor(model => model.Address)
            }
            else
            {
                <span>No address available</span>
            }
        </dd>
        <dt class="col-sm-2">Services</dt>
        <dd class="col-sm-10">
            @if (Model.ClientServices != null && Model.ClientServices.Any())
            {
                <ul>
                    @foreach (var service in Model.ClientServices)
                    {
                        <li>@service.Service.Name</li>
                    }
                </ul>
            }
            else
            {
                <span>No services assigned</span>
            }
        </dd>
    </dl>
    </dl>
</div>
<form asp-action="Delete">
    <input type="hidden" asp-for="ID" />
    <input type="submit" value="Delete" class="btn btn-danger" /> |
    <a asp-action="Index">Back to List</a>
</form>

