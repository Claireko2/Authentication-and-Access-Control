@{
    ViewData["Title"] = "SMS Two-Factor Authentication";
}

<h2>SMS Two-Factor Authentication</h2>

<p>
    Verify your phone number to enable SMS
    two-factor authentication.
</p>

<form asp-controller="TwoFactor"
      asp-action="SendCode"
      method="post">

    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-primary">
        Send Verification Code
    </button>

</form>
