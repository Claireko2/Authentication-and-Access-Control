@{
    ViewData["Title"] = "Verify Phone";
}

<h2>Verify Phone Number</h2>

<p>
    Enter the verification code sent to your phone.
</p>

<form asp-action="Verify" method="post">

    <div asp-validation-summary="All"
         class="text-danger">
    </div>

    <div class="mb-3">
        <label for="code"
               class="form-label">
            Verification Code
        </label>

        <input type="text"
               id="code"
               name="code"
               class="form-control"
               autocomplete="one-time-code"
               maxlength="10"
               required />
    </div>

    <button type="submit"
            class="btn btn-primary">
        Verify Code
    </button>

</form>
