@using Microsoft.AspNetCore.Identity
@using MVP_1B2.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="nav-link text-dark">
                Hello @UserManager.GetUserName(User)!
            </span>
        </li>

        <li class="nav-item">
            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home")"
                  method="post">

                <button type="submit"
                        class="nav-link btn btn-link text-dark">
                    Logout
                </button>

            </form>
        </li>
        @if (User.IsInRole("Client"))
        {
            <li class="nav-item">
                <a class="nav-link text-dark"
                   asp-controller="Clients"
                   asp-action="MyProfile">
                    My Profile
                </a>
            </li>
        }

        @if (User.IsInRole("Employee") ||
            User.IsInRole("Manager"))
        {
            <li class="nav-item">
                <a class="nav-link text-dark"
                   asp-controller="Employees"
                   asp-action="MyProfile">
                    My Profile
                </a>
            </li>
        }
        @if (SignInManager.IsSignedIn(User))
        {
            <li class="nav-item">
                <a class="nav-link text-dark"
                   asp-area="Identity"
                   asp-page="/Account/Manage/ChangePassword">
                    Change Password
                </a>
            </li>
        }
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-area="Identity"
               asp-page="/Account/Login">
                Login
            </a>
        </li>
    }

</ul>
